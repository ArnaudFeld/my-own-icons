{
  "name": "moi-icons",
  "version": "0.0.14",
  "description": "Obsidian Plugin: {{icon:name}} in Notizen und Explorer Icons per Rechtsklick",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "npm run typecheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck && tsc -p tsconfig.scripts.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/run-tests.mjs",
    "fetch-icons": "python3 scripts/fetch-icons.py",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@codemirror/language": "^6.10.1",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.33.0",
    "@types/node": "^20.11.0",
    "esbuild": "0.20.2",
    "obsidian": "latest",
    "prettier": "^3.9.9",
    "typescript": "^5.3.3"
  }
}
